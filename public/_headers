# Read by Cloudflare Pages (and Netlify). Vite copies this file into dist/.
# Vercel ignores it; see docs/DEPLOY.md if you choose Vercel.

# Built files have a hash in their name, so they never change under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
